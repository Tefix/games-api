{
  "swagger": "2.0",
  "info": {
    "title": "Games API",
    "version": "1.0.0",
    "description": "### This is a Swagger UI for our Games API\n\n### Error handling\nErrors are presented using the HTTP status codes 400-599. The response includes a more detailed explanation about the error in the body.\n\n```\n{\n \"error\": \"Cleartext explanation of the error that occurred\"\n}\n```\n\n### Generic API errors\nThese error responses can be returned by any of the described endpoints.\n\n| HTTP status | Description |\n|---|---|\n| 400 | Bad input parameters or invalid request. More information can be found in the response body. |\n| 401 | The consumer does not have access to the requested resource or the provided token is not valid. |\n| 404 | The requested resource can not be found or the user does not have access to the resource. |\n| 5XX | A server error has occurred while processing the request. |"
  },
  "paths": {
    "/games": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get a list of all games",
        "description": "Returns all games. Available to everyone.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of all games",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Game"
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Games"
        ],
        "summary": "Add a new game",
        "description": "Creates a new game. Game titles must be unique (case-insensitive).",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Game created",
            "headers": {
              "Location": {
                "type": "string",
                "description": "URL of the created game"
              }
            },
            "schema": {
              "$ref": "#/definitions/Game"
            }
          },
          "400": {
            "description": "Missing fields or invalid values",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Game with the same title already exists",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/games/{id}": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get full details of a given game",
        "description": "Returns a single game by its ID. Available to everyone.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Game ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Game details",
            "schema": {
              "$ref": "#/definitions/Game"
            }
          },
          "400": {
            "description": "Invalid ID format",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Game not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Games",
      "description": "Games catalogue"
    }
  ],
  "definitions": {
    "Game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Witcher 3"
        },
        "price": {
          "type": "number",
          "example": 29.99
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Game not found"
        }
      }
    },
    "GameInput": {
      "type": "object",
      "required": [
        "name",
        "price"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Hades"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "example": 24.5
        }
      }
    }
  }
}