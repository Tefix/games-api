{
  "swagger": "2.0",
  "info": {
    "title": "Games API",
    "version": "1.0.0",
    "description": "### This is a Swagger UI for our Games API\n\n### Error handling\nErrors are presented using the HTTP status codes 400-599. The response includes a more detailed explanation about the error in the body.\n\n```\n{\n \"error\": \"Cleartext explanation of the error that occurred\"\n}\n```\n\n### Generic API errors\nThese error responses can be returned by any of the described endpoints.\n\n| HTTP status | Description |\n|---|---|\n| 400 | Bad input parameters or invalid request. More information can be found in the response body. |\n| 401 | The consumer does not have access to the requested resource or the provided token is not valid. |\n| 404 | The requested resource can not be found or the user does not have access to the resource. |\n| 5XX | A server error has occurred while processing the request. |"
  },
  "paths": {
    "/games": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get a list of all games",
        "description": "Returns all games. Available to everyone.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of all games",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Game"
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Games"
        ],
        "summary": "Add a new game",
        "description": "Creates a new game. Game titles must be unique (case-insensitive). Requires authentication.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Game created",
            "headers": {
              "Location": {
                "type": "string",
                "description": "URL of the created game"
              }
            },
            "schema": {
              "$ref": "#/definitions/Game"
            }
          },
          "400": {
            "description": "Missing fields or invalid values",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Game with the same title already exists",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/games/{id}": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get full details of a given game",
        "description": "Returns a single game by its ID. Available to everyone.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Game ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Game details",
            "schema": {
              "$ref": "#/definitions/Game"
            }
          },
          "400": {
            "description": "Invalid ID format",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Game not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Games"
        ],
        "summary": "Delete a game",
        "description": "Deletes a game by its ID. Admin only.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Game ID",
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Game deleted"
          },
          "400": {
            "description": "Invalid ID format",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Game not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Admin role required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "Games"
        ],
        "summary": "Update a game",
        "description": "Replaces name and price of a game. Game titles must be unique (case-insensitive). Admin only.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Game ID",
            "example": 1
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated game",
            "schema": {
              "$ref": "#/definitions/Game"
            }
          },
          "400": {
            "description": "Invalid ID, missing fields or invalid values",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Game not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Game with the same title already exists",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Admin role required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "description": "Creates a regular user (role `user`).",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Credentials"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "400": {
            "description": "Missing fields or invalid username/password (username 3-30 chars, password 8-100 chars)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Username already taken",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in",
        "description": "Returns a bearer token valid for 1 hour.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Credentials"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logged in",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Missing fields",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Invalid username or password",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "description": "Invalidates the current token.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users (admin only)",
        "security": [
          {
            "bearer": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "All users",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/User"
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Admin role required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/users/{id}": {
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete a user (admin only)",
        "security": [
          {
            "bearer": []
          }
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "User ID"
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted"
          },
          "400": {
            "description": "Invalid ID or attempt to delete own account",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Admin role required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "User not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/users/{id}/role": {
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Change user role (admin only)",
        "security": [
          {
            "bearer": []
          }
        ],
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "User ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RoleInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated user",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "400": {
            "description": "Invalid ID, invalid role or attempt to remove own admin role",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Admin role required",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "User not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Games",
      "description": "Games catalogue"
    },
    {
      "name": "Auth",
      "description": "Registration and login"
    },
    {
      "name": "Users",
      "description": "User management (admin only)"
    }
  ],
  "definitions": {
    "Game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Witcher 3"
        },
        "price": {
          "type": "number",
          "example": 29.99
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Game not found"
        }
      }
    },
    "GameInput": {
      "type": "object",
      "required": [
        "name",
        "price"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Hades"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "example": 24.5
        }
      }
    },
    "Credentials": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "bob"
        },
        "password": {
          "type": "string",
          "example": "password123"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 2
        },
        "username": {
          "type": "string",
          "example": "bob"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ]
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/User"
        }
      }
    },
    "RoleInput": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ]
        }
      }
    }
  },
  "securityDefinitions": {
    "bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Token from POST /auth/login, sent as `Bearer <token>`"
    }
  }
}